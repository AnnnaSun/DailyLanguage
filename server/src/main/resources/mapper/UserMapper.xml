<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dailylanguage.user.UserMapper">

    <select id="insertReturningId"
            resultType="java.util.UUID"
            affectData="true"
            flushCache="true">
        INSERT INTO app_user DEFAULT VALUES
        RETURNING id
    </select>
</mapper>
