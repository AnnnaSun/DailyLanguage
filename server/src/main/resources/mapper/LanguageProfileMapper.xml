<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dailylanguage.languageprofile.infrastructure.LanguageProfileMapper">

    <resultMap id="languageProfileIdentityResult"
               type="com.dailylanguage.languageprofile.domain.LanguageProfileIdentity">
        <constructor>
            <idArg column="id"
                   javaType="java.util.UUID"
                   typeHandler="com.dailylanguage.persistence.PostgreSqlUuidTypeHandler"/>
            <arg column="user_id"
                 javaType="java.util.UUID"
                 typeHandler="com.dailylanguage.persistence.PostgreSqlUuidTypeHandler"/>
            <arg column="language_code" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="insertLanguageProfileAndReturn"
            resultMap="languageProfileIdentityResult"
            affectData="true"
            flushCache="true">
        INSERT INTO language_profile (user_id, language_code)
        VALUES (#{userId, jdbcType=OTHER}, #{languageCode, jdbcType=VARCHAR})
        <!-- 依赖数据库唯一约束原子裁决并发重复创建，避免 check-then-insert race。 -->
        ON CONFLICT (user_id, language_code) DO NOTHING
        RETURNING id, user_id, language_code
    </select>

    <select id="findByIdAndUserId" resultMap="languageProfileIdentityResult">
        SELECT id, user_id, language_code
        FROM language_profile
        WHERE id = #{languageProfileId, jdbcType=OTHER}
          AND user_id = #{userId, jdbcType=OTHER}
    </select>

    <select id="findAllByUserId" resultMap="languageProfileIdentityResult">
        SELECT id, user_id, language_code
        FROM language_profile
        WHERE user_id = #{userId, jdbcType=OTHER}
        ORDER BY language_code ASC, id ASC
    </select>
</mapper>
